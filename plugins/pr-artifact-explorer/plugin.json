{
  "name": "pr-artifact-explorer",
  "description": "瀏覽提取要求並安全地探索 GitHub Actions 成品，包含測試結果、靜態網站、終端機錄製和原始程式碼檔案。",
  "version": "1.0.0",
  "author": {
    "name": "David Pine",
    "url": "https://github.com/IEvangelist"
  },
  "keywords": [
    "actions-artifacts",
    "artifact-browser",
    "canvas",
    "copilot-extension",
    "github-actions",
    "pull-requests",
    "test-results"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/pr-artifact-explorer"
      ]
    }
  },
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
}
