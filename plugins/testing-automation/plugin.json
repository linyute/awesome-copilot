{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "testing-automation",
  "description": "用於撰寫測試、測試自動化和測試驅動開發的完整集合，包含單元測試、整合測試與端對端測試策略。",
  "version": "1.0.0",
  "author": {
    "name": "Awesome Copilot Community"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "testing",
    "tdd",
    "automation",
    "unit-tests",
    "integration",
    "playwright",
    "jest",
    "nunit"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "agents": [
        "./agents/playwright-tester.md",
        "./agents/tdd-green.md",
        "./agents/tdd-red.md",
        "./agents/tdd-refactor.md"
      ],
      "skills": [
        "./skills/ai-prompt-engineering-safety-review/",
        "./skills/csharp-nunit/",
        "./skills/java-junit/",
        "./skills/playwright-explore-website/",
        "./skills/playwright-generate-test/"
      ]
    }
  }
}
