{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "draw",
  "description": "在 Copilot 畫布中繪製簡易圖表：形狀、保持連接的箭號、文字以及自由繪製的畫筆。Copilot 能夠讀取、建立與編輯同一份繪圖、整理其版面配置，並將其匯出為 PNG 或 SVG。",
  "version": "1.0.0",
  "author": {
    "name": "Burke Holland",
    "url": "https://github.com/burkeholland"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "architecture-diagrams",
    "canvas",
    "diagrams",
    "drawing",
    "flowcharts",
    "whiteboard"
  ],
  "extensions": {
    "com.github.copilot": {
      "logo": "assets/preview.png"
    },
    "com.github.awesome-copilot": {
      "extensions": [
        "./extensions/draw"
      ]
    }
  }
}
