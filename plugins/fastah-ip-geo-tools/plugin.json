  "license": "Apache-2.0",
  "keywords": [
    "geofeed",
    "ip-geolocation",
    "rfc-8805",
    "rfc-9632",
    "network-operations",
    "isp",
    "cloud",
    "hosting",
    "ixp"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "skills": [
        "./skills/geofeed-tuner/"
      ]
