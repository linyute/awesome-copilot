  "version": "1.0.0",
  "author": {
    "name": "Awesome Copilot Community"
  },
  "repository": "https://github.com/github/awesome-copilot",
  "license": "MIT",
  "keywords": [
    "document-analysis",
    "citation-verification",
    "screenshot",
    "contracts",
    "legal",
    "trust",
    "visual-verification"
  ],
  "extensions": {
    "com.github.awesome-copilot": {
      "skills": [
        "./skills/eyeball/"
      ]
    }
  }
